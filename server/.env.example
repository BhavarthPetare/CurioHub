# Copy to server/.env and fill in.

# Required. MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/curiohub

# Required. Long random string used to sign login tokens. In production the server
# refuses to start if it is shorter than 32 characters or contains "change-me". e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optional. Defaults to 5000.
PORT=5000

# Set to "production" on the host. Enables the strict checks below.
# NODE_ENV=production

# Optional. Extra browser origin(s) allowed to call the API and sockets, comma-separated.
# Development default: any origin. Production default: same origin only, which is
# right when this server also serves the built client. Leave unset in that case.
CORS_ORIGIN=http://localhost:5173

# Optional. Number of reverse proxies in front of the server (e.g. 1 on Render/Heroku),
# so rate limiting sees real client IPs.
# TRUST_PROXY=1
